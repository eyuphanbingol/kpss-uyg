{
  "expo": {
    "name": "Atanly",
    "slug": "atanly",
    "scheme": "atanly",
    "version": "1.0.13",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#041C24"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.atanly.mobile",
      "requireFullScreen": true,
      "splash": {
        "image": "./assets/splash-full.png",
        "resizeMode": "contain",
        "backgroundColor": "#041C24"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Canlı denemede optik formunun fotoğrafını çekip cevaplarını okumak için kamerayı kullanırız.",
        "NSPhotoLibraryUsageDescription": "Canlı denemede optik formunun fotoğrafını galeriden seçebilmen için kullanılır."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.atanly.mobile",
      "versionCode": 12,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#041C24",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "splash": {
        "image": "./assets/splash-full.png",
        "resizeMode": "contain",
        "backgroundColor": "#041C24"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "atanly",
              "host": "auth",
              "pathPrefix": "/callback"
            },
            {
              "scheme": "atanly",
              "host": "reset"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#041C24"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#041C24",
          "image": "./assets/splash-full.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#041C24",
            "image": "./assets/splash-full.png"
          }
        }
      ],
      "expo-asset"
    ],
    "owner": "eyuphan.bingol"
  }
}
