{
  "expo": {
    "name": "Atanom",
    "slug": "eyphn",
    "scheme": "atanom",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/atanom.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-full.png",
      "resizeMode": "cover",
      "backgroundColor": "#041C24"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.atanom.mobile",
      "splash": {
        "backgroundColor": "#041C24",
        "image": "./assets/splash-full.png",
        "resizeMode": "cover"
      }
    },
    "android": {
      "package": "app.atanom.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#041C24",
        "foregroundImage": "./assets/atanom-mark.png"
      },
      "splash": {
        "backgroundColor": "#041C24",
        "image": "./assets/splash-full.png",
        "resizeMode": "cover"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#041C24",
          "image": "./assets/atanom-mark.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0548f69d-e960-4d00-aadb-4f2e90a3eb3a"
      }
    },
    "owner": "eyphns-team"
  }
}
