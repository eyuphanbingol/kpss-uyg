{
  "expo": {
    "name": "Atanly",
    "slug": "eyphn",
    "scheme": "atanly",
    "version": "1.0.2",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.atanly.mobile",
      "requireFullScreen": true
    },
    "android": {
      "package": "app.atanly.mobile",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#041C24",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#041C24",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#041C24",
            "image": "./assets/adaptive-icon.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0548f69d-e960-4d00-aadb-4f2e90a3eb3a"
      }
    },
    "owner": "eyphns-team"
  }
}
