{
  "expo": {
    "name": "Atanly",
    "slug": "eyphn",
    "scheme": "atanly",
    "version": "1.0.11",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#041C24"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.atanly.mobile",
      "requireFullScreen": true,
      "splash": {
        "image": "./assets/splash-full.png",
        "resizeMode": "contain",
        "backgroundColor": "#041C24"
      }
    },
    "android": {
      "package": "app.atanly.mobile",
      "versionCode": 12,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#041C24",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "splash": {
        "image": "./assets/splash-full.png",
        "resizeMode": "contain",
        "backgroundColor": "#041C24"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "atanly", "host": "auth", "pathPrefix": "/callback" },
            { "scheme": "atanly", "host": "reset" }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#041C24"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#041C24",
          "image": "./assets/splash-full.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#041C24",
            "image": "./assets/splash-full.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0548f69d-e960-4d00-aadb-4f2e90a3eb3a"
      }
    },
    "owner": "eyphns-team"
  }
}
